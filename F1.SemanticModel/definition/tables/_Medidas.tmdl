			.pl-kpi { position: relative !important; padding: 9px 12px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
			.pl-kpi small { font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--txt2); font-weight: 700; }
