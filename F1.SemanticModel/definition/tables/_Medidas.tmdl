			.pl-h-cod span { color: var(--txt2); letter-spacing: 1px; filter: none; }
			.pl-h-nome { margin: 4px 0 14px; display: flex; flex-direction: column; line-height: .95; }
			.pl-h-nome span { font-size: 26px; font-weight: 400; color: var(--txt2); }
