			.pl-lado { left: 16px; top: 60px; width: 292px; height: 644px; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
			.pl-filtros { display: flex; gap: 6px; align-items: center; justify-content: space-between; }
			.pl-filtros .f1-select { flex: 1; min-width: 0; }
			.pl-lista { flex: 1; margin: 0 -6px; padding: 0 6px; }
			.pl-it { display: flex; align-items: center; gap: 9px; padding: 6px 8px; border-radius: 10px; cursor: pointer; position: relative; margin-bottom: 2px; transition: background .12s; }
			.pl-it::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; border-radius: 2px; background: var(--c); opacity: .9; }
			.pl-it:hover { background: #1A1F2B; }
