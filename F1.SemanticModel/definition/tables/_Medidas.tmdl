			    USA: ['us', 'EUA'], 'United States': ['us', 'EUA'], Italy: ['it', 'Itália'], Monaco: ['mc', 'Mônaco'], Canada: ['ca', 'Canadá'], Spain: ['es', 'Espanha'],
