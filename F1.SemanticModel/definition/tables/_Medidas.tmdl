			    };
			    alvo.addEventListener('click', (ev) => { if (ev.target.closest('.f1-sel-btn')) { if (alvo.classList.contains('aberto')) fechar(); else abrir(); } });
			    F1.ouvir(document, 'mousedown', (ev) => { if (!alvo.contains(ev.target)) fechar(); });
			    desenhar();
