			      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			    };
			  };
			  F1.hash = (txt) => { let h = 2166136261; for (const ch of String(txt)) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };
			  F1.embaralhar = (arr, r) => { const a = arr.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor((r || Math.random)() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
			})();
			
			/* Pagina Temporada: corrida de barras do campeonato rodada a rodada, campeao e calendario com resultados. */
			(function () {
			  'use strict';
			  const F1 = window.F1;
			  const palco = F1.palco('Temporada', 'Campeonato rodada a rodada');
			  palco.insertAdjacentHTML('beforeend', `
			<div class='te-anos f1-scroll'></div>
			<section class='te-corrida f1-cartao'>
			  <div class='te-cab'>
			    <div class='te-rodada'><small>RODADA</small><b>–</b></div>
			    <div class='te-gp'><b></b><small></small></div>
			    <div class='f1-seg te-modo'><button data-m='p' class='on'>Pilotos</button><button data-m='e'>Equipes</button></div>
			  </div>
			  <div class='te-barras'></div>
			  <div class='te-ctrl'>
			    <button class='f1-btn te-ini' data-tip='Primeira rodada'>⏮</button>
			    <button class='f1-btn prim te-play'>▶ Reproduzir</button>
			    <button class='f1-btn te-fim' data-tip='Última rodada'>⏭</button>
			    <input type='range' class='te-slider' min='0' max='0' value='0'>
			    <div class='f1-seg te-vel'><button data-v='1' class='on'>1×</button><button data-v='2'>2×</button><button data-v='4'>4×</button></div>
			  </div>
			  <div class='te-nota'>Pontos de corridas e sprints somados por rodada.</div>
			</section>
			<section class='te-campeao f1-cartao'></section>
			<section class='te-cal f1-cartao'><div class='f1-rot'>Calendário <span class='te-cal-n'></span></div><div class='te-cal-lista f1-scroll'></div><div class='te-det'></div></section>`);
			  const $ = (s) => palco.querySelector(s);
			  const LINHAS = 10, ALT = 44;
			  const est = { ano: F1.ler('te.ano', 0), modo: 'p', quadros: [], i: 0, play: null, vel: 1, rows: new Map(), valores: new Map() };
			  if (!F1.anos.includes(est.ano)) est.ano = F1.anos.filter((a) => F1.temporadaCompleta(a)).pop() || F1.anos[F1.anos.length - 1] || 0;
			
			  // ---------- seletor de anos ----------
			  const desenharAnos = () => {
			    $('.te-a"
			& "nos').innerHTML = F1.anos.map((a) => {
			      const c = F1.campeoes.get(a);
			      const cor = c && c.p ? F1.corPiloto(c.p, a) : '#3A4253';
			      return `<button class='te-ano${a === est.ano ? ' on' : ''}' data-a='${a}' style='--c:${cor}'>${a}${F1.temporadaCompleta(a) ? '' : '<i>•</i>'}</button>`;
			    }).join('');
			    const on = $('.te-ano.on'); if (on) on.scrollIntoView({ inline: 'center', block: 'nearest' });
			  };
			
			  // ---------- barras ----------
			  const chave = (k) => est.modo + k;
			  const montarBarras = () => {
			    est.quadros = F1.pontosAcumulados(est.ano, est.modo === 'e');
			    est.rows.clear(); est.valores.clear();
			    const caixa = $('.te-barras');
			    caixa.innerHTML = '';
			    const todos = new Set();
			    est.quadros.forEach((q) => q.pts.forEach((_, k) => todos.add(k)));
			    todos.forEach((k) => {
			      const el = document.createElement('div');
			      el.className = 'te-row';
			      const ehP = est.modo === 'p';
			      const cor = ehP ? F1.corPiloto(k, est.ano) : F1.e(k).cor;
			      const nome = ehP ? F1.p(k).completo : F1.e(k).nome;
			      const sub = ehP ? F1.e(F1.equipeDoPiloto(k, est.ano)).nome : '';
			      el.style.setProperty('--c', cor);
			      el.innerHTML = `<div class='te-pos'></div>${ehP ? F1.avatar(k, 'mini', est.ano) : `<div class='te-eqi' style='background:${cor}'></div>`}` +
			        `<div class='te-nome'><b>${F1.esc(nome)}</b><small>${F1.esc(sub)}</small></div>` +
			        `<div class='te-trilho'><div class='te-barra'><span class='te-vit'></span></div></div><div class='te-val'>0</div>`;
			      el.style.transform = `translateY(${(LINHAS + 1) * ALT}px)`;
			      el.style.opacity = '0';
			      caixa.appendChild(el);
			      est.rows.set(chave(k), el);
			    });
			    const sl = $('.te-slider');
			    sl.max = String(Math.max(0, est.quadros.length - 1));
			    est.i = est.quadros.length - 1;
			    sl.value = String(est.i);
			    mostrar(est.i, true);
			  };
			
			  const mostrar = (i, instantaneo) => {
			    const q = est.quadros[i];
			    const cab = $('.te-cab');
			    if (!q) { cab.querySelector('.te-rodada b').textContent = '–'; cab.querySelector('.te-gp b').textContent = 'Sem corridas nesta temporada'; return; }
			    const total = F1.ultimaRodada(est.ano);
			    cab.querySelector('.te-rodada b').innerHTML = `${q.corrida.rod}<small>/${total}</small>`;
			    const ci = F1.circuitos.get(q.corrida.circ);
			    cab.querySelector('.te-gp b').innerHTML = `${ci ? F1.bandeiraPais(ci.pais) : ''} ${F1.esc(F1.gpNome(q.corrida.k))}`;
			    cab.querySelector('.te-gp small').textContent = (ci ? ci.nome + ' · ' : '') + F1.data(q.corrida.data);
			    const ordem = [...q.pts.entries()].sort((a, b) => b[1] - a[1] || (q.vit.get(b[0]) || 0) - (q.vit.get(a[0]) || 0));
			    const max = Math.max(1, ordem.length ? ordem[0][1] : 1);
			    const lider = ordem.length ? ordem[0][1] : 0;
			    const vistos = new Set();
			    ordem.forEach(([k, v], pos) => {
			      const el = est.rows.get(chave(k)); if (!el) return;
			      vistos.add(el);
			      el.classList.toggle('inst', !!instantaneo);
			      el.style.transform = `translateY(${Math.min(pos, LINHAS) * ALT}px)`;
			      el.style.opacity = pos < LINHAS ? '1' : '0';
			      el.style.zIndex = String(100 - pos);
			      el.classList.toggle('lider', pos === 0);
			      el.querySelector('.te-pos').textContent = pos + 1;
			      el.querySelector('.te-barra').style.width = `${Math.max(0.6, (v / max) * 100)}%`;
			      const nv = q.vit.get(k) || 0;
			      el.querySelector('.te-vit').textContent = nv ? `${nv} ${nv === 1 ? 'vitória' : 'vitórias'}` : '';
			      animarValor(el.querySelector('.te-val'), k, v, instantaneo, pos === 0 ? '' : '−' + F1.pts(lider - v));
			    });
			    est.rows.forEach((el) => { if (!vistos.has(el)) el.style.opacity = '0'; });
			    $('.te-slider').value = String(i);
			    marcarCalendario(q.corrida.k);
			  };
			
			  const animarValor = (el, k, v, inst, dif) => {
			    const de = est.valores.has(chave(k)) ? est.valores.get(chave(k)) : 0;
			    est.valores.set(chave(k), v);
			    const fim = () => { el.innerHTML = `${F1.pts(v)}${dif ? `<small>${dif}</small>` : '"
			& "'}`; };
			    if (inst || de === v) { fim(); return; }
			    const ini = performance.now(), dur = 520 / est.vel;
			    F1.anim((t) => {
			      const kk = Math.min(1, (t - ini) / dur);
			      el.textContent = F1.fmt(de + (v - de) * kk, 0);
			      if (kk >= 1) fim();
			      return kk < 1;
			    });
			  };
			
			  // ---------- reproducao ----------
			  const pararPlay = () => { if (est.play) { F1.parar(est.play); est.play = null; } $('.te-play').innerHTML = '▶ Reproduzir'; };
			  const iniciarPlay = () => {
			    if (!est.quadros.length) return;
			    if (est.i >= est.quadros.length - 1) { est.i = 0; mostrar(0, true); }
			    $('.te-play').innerHTML = '⏸ Pausar';
			    const passo = () => {
			      if (est.i >= est.quadros.length - 1) { pararPlay(); return; }
			      est.i++; mostrar(est.i);
			      est.play = F1.espera(passo, 1100 / est.vel);
			    };
			    est.play = F1.espera(passo, 500 / est.vel);
			  };
			
			  // ---------- campeao ----------
			  const desenharCampeao = () => {
			    const box = $('.te-campeao');
			    const fim = F1.finalP.get(est.ano) || [], fimE = F1.finalE.get(est.ano) || [];
			    const completa = F1.temporadaCompleta(est.ano);
			    const l = fim[0];
			    if (!l) { box.innerHTML = `<div class='te-camp-vazio'>Sem classificação para ${est.ano}.</div>`; return; }
			    const pi = F1.p(l.p), e = F1.e(l.e), le = fimE[0] ? F1.e(fimE[0].e) : null;
			    const vice = fim[1];
			    box.style.setProperty('--c', e.cor);
			    box.innerHTML = `<div class='te-camp-bg'></div>${F1.avatar(l.p, 'medio', est.ano)}
			      <div class='te-camp-txt'><small>${completa ? `★ CAMPEÃO ${est.ano}` : `LÍDER APÓS A RODADA ${l.rod} DE ${F1.ultimaRodada(est.ano)}`}</small>
			      <b>${F1.esc(pi.completo)}</b><span>${F1.esc(e.nome)} · ${F1.pts(l.pts)} pts · ${l.vit} vitórias</span>
			      ${vice ? `<em>${completa ? 'Vice' : '2º'}: ${F1.esc(F1.p(vice.p).completo)} (−${F1.pts(l.pts - vice.pts)})</em>` : ''}</div>
			      ${le ? `<div class='te-camp-eq' style='--c2:${le.cor}'><small>${completa ? 'Construtores' : 'Líder construtores'}</small><b>${F1.esc(le.nome)}</b><span>${F1.pts(fimE[0].pts)} pts</span></div>` : ''}`;
			  };
			
			  // ---------- calendario ----------
			  const desenharCalendario = () => {
			    const lista = F1.corridasPorAno.get(est.ano) || [];
			    $('.te-cal-n').textContent = `${lista.filter((c) => F1.corridaRealizada(c.k)).length}/${lista.length} corridas`;
			    $('.te-cal-lista').innerHTML = lista.map((c) => {
			      const ci = F1.circuitos.get(c.circ), rs = F1.resPorCorrida.get(c.k);
			      const v = rs ? rs[0] : null;
			      const temSprint = F1.spPorCorrida.has(c.k);
			      return `<div class='te-gp-it${rs ? '' : ' fut'}' data-c='${c.k}'><em>${c.rod}</em>${ci ? F1.bandeiraPais(ci.pais) : ''}` +
			        `<span><b>${F1.esc(F1.gpNome(c.k))}${temSprint ? ` <i class='te-spr'>SPRINT</i>` : ''}</b><small>${F1.esc(F1.dataCurta(c.data))}${ci ? ' · ' + F1.esc(ci.cidade) : ''}</small></span>` +
			        (v ? `<strong style='--c:${F1.e(v.e).cor}'>${F1.esc(F1.p(v.p).cod)}</strong>` : `<strong class='nd'>—</strong>`) + `</div>`;
			    }).join('') || `<div class='te-camp-vazio'>Sem calendário.</div>`;
			  };
			  const marcarCalendario = (c) => {
			    palco.querySelectorAll('.te-gp-it').forEach((el) => el.classList.toggle('on', +el.getAttribute('data-c') === c));
			    const on = $('.te-gp-it.on'); if (on && !est.play) on.scrollIntoView({ block: 'nearest' });
			  };
			
			  const detalhe = (c) => {
			    const rs = F1.resPorCorrida.get(c), det = $('.te-det');
			    if (!rs) { det.classList.remove('aberto'); return; }
			    const ci = F1.circuitos.get(F1.corridas.get(c).circ);
			    const pod = [rs[1], rs[0], rs[2]].filter(Boolean);
			    const pole = rs.find((r) => r.grid === 1), vr = rs.find((r) => r.vr), dnf = rs.filter((r) => r.st >= 2 && r.st <= 3).length;
			    det.innerHTML = `<button class='f1-btn te-volta'>← Calendário</button>
			      <div class='te-det-tit'>${ci ? F1.bandeiraPais(ci.pais) : ''}<b>${F1.esc(F1.gpNome(c))} ${Math.floor(c / 100)}</b><small>${ci ? F1.esc(ci.nome) : ''}</small></div>
			      <div class='te-podio'>${pod.map("
			& "(r) => `<div class='te-deg p${r.pos}' style='--c:${F1.e(r.e).cor}'>${F1.avatar(r.p, 'medio', Math.floor(c / 100))}<b>${F1.esc(F1.p(r.p).cod)}</b><div class='te-bloco'>${r.pos}</div></div>`).join('')}</div>
			      <div class='te-det-lista'>${rs.slice(3, 10).map((r) => `<div><em>${r.pos}</em><i style='background:${F1.e(r.e).cor}'></i><span>${F1.esc(F1.p(r.p).completo)}</span><small>${r.pts ? '+' + F1.pts(r.pts) : ''}</small></div>`).join('')}</div>
			      <div class='te-det-rod'>${pole ? `Pole: <b>${F1.esc(F1.p(pole.p).cod)}</b>` : ''}${vr ? ` · Volta rápida: <b>${F1.esc(F1.p(vr.p).cod)}</b>` : ''} · Abandonos: <b>${dnf}</b></div>`;
			    det.classList.add('aberto');
			  };
			
			  // ---------- eventos ----------
			  const trocarAno = (a) => {
			    pararPlay();
			    est.ano = a; F1.gravar('te.ano', a);
			    desenharAnos(); desenharCampeao(); desenharCalendario(); montarBarras();
			    $('.te-det').classList.remove('aberto');
			  };
			  $('.te-anos').addEventListener('click', (ev) => { const b = ev.target.closest('.te-ano'); if (b) trocarAno(+b.getAttribute('data-a')); });
			  $('.te-modo').addEventListener('click', (ev) => {
			    const b = ev.target.closest('button'); if (!b) return;
			    est.modo = b.getAttribute('data-m');
			    palco.querySelectorAll('.te-modo button').forEach((x) => x.classList.toggle('on', x === b));
			    const i = est.i; pararPlay(); montarBarras(); est.i = Math.min(i, est.quadros.length - 1); mostrar(est.i, true);
			  });
			  $('.te-play').addEventListener('click', () => (est.play ? pararPlay() : iniciarPlay()));
			  $('.te-ini').addEventListener('click', () => { pararPlay(); est.i = 0; mostrar(0); });
			  $('.te-fim').addEventListener('click', () => { pararPlay(); est.i = est.quadros.length - 1; mostrar(est.i); });
			  $('.te-slider').addEventListener('input', (ev) => { pararPlay(); est.i = +ev.target.value; mostrar(est.i); });
			  $('.te-vel').addEventListener('click', (ev) => {
			    const b = ev.target.closest('button'); if (!b) return;
			    est.vel = +b.getAttribute('data-v');
			    palco.querySelectorAll('.te-vel button').forEach((x) => x.classList.toggle('on', x === b));
			    $('.te-barras').style.setProperty('--dur', (0.6 / est.vel).toFixed(2) + 's');
			  });
			  $('.te-cal-lista').addEventListener('click', (ev) => {
			    const it = ev.target.closest('.te-gp-it'); if (!it) return;
			    const c = +it.getAttribute('data-c');
			    const idx = est.quadros.findIndex((q) => q.corrida.k === c);
			    if (idx >= 0) { pararPlay(); est.i = idx; mostrar(idx); }
			    detalhe(c);
			  });
			  $('.te-det').addEventListener('click', (ev) => { if (ev.target.closest('.te-volta')) $('.te-det').classList.remove('aberto'); });
			
			  trocarAno(est.ano);
			})();
			"
			RETURN
			    "<div id='app-raiz'></div><script>" & _dados & "</script><script>" & _motor & "</script>"
		displayFolder: <HTML>
		lineageTag: c61c594b-a573-405b-a971-a9fc24542660

	measure '<CSS> Temporada' =
			
			"@import url('https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;900&display=swap');
			#app-raiz {
			  --bg: #0A0C10; --card: #12161E; --card2: #181D28; --borda: #242A36; --borda2: #323A4A;
			  --txt: #ECEEF2; --txt2: #9AA3B2; --txt3: #626B7C; --red: #E10600; --red2: #FF3B30; --ok: #2BD47D; --warn: #FFC53D;
			  position: fixed; inset: 0; overflow: hidden; background: var(--bg); color: var(--txt);
			  font-family: 'Titillium Web', 'Segoe UI', system-ui, sans-serif; font-size: 13px; line-height: 1.35;
			  -webkit-font-smoothing: antialiased; user-select: none;
			}
			#app-raiz * { box-sizing: border-box; }
			#app-raiz button, #app-raiz input, #app-raiz select { font-family: inherit; }
			.f1-fundo {
			  position: absolute; inset: 0;
			  background:
			    radial-gradient(900px 420px at 92% -12%, rgba(225, 6, 0, .20), transparent 62%),
			    radial-gradient(700px 400px at -10% 110%, rgba(60, 90, 160, .14), transparent 60%),
			    repeating-linear-gradient(135deg, rgba(255, 255, 255, .018) 0 2px, transparent 2px 7px),
			    var(--bg);
			}
			.f1-palco { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; }
			.f1-palco > section, .f1-palco > aside, .f1-palco > div { position: absolute; }
			
			/* topo: o navegador nativo do Power BI fica a esquerda (x 16..616) */
			.f1-topo { position: absolute; left: 640px; right: 16px; top: 10px; height: 36px; display: flex; align-items: center; justify-content: flex-end; gap: 18px; }
			.f1-titulo { display: flex; align-items: baseline; gap: 10px; }
			.f1-tit { font-size: 20px; font-weight: 900; letter-spacing: .5px; text-transform: uppercase; }
			.f1-sub { color: var(--txt2); font-size: 12px; font-weight: 600; }
			.f1-marca { display: flex; align-items: center; gap: 4px; font-weight: 900; font-style: italic; letter-spacing: 1px; font-size: 13px; color: var(--txt2); }
			.f1-marca b { color: #fff; background: var(--red); padding: 0 6px; border-radius: 3px; font-size: 14px; }
			.f1-marca i { width: 18px; height: 3px; background: linear-gradient(90deg, transparent, var(--red)); margin-right: 2px; }
			
			/* blocos */
			.f1-cartao { background: linear-gradient(180deg, rgba(255, 255, 255, .025), transparent 40%), var(--card); border: 1px solid var(--borda); border-radius: 14px; }
			.f1-rot { font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--txt2); display: flex; align-items: center; gap: 8px; }
			.f1-rot::before { content: ''; width: 3px; height: 12px; background: var(--red); border-radius: 2px; }
			.f1-dica { display: inline-grid; place-items: center; width: 15px; height: 15px; border-radius: 50%; border: 1px solid var(--borda2); font-size: 10px; color: var(--txt3); cursor: help; letter-spacing: 0; }
			.f1-vazio { position: absolute; left: 340px; top: 300px; width: 600px; padding: 24px; text-align: center; background: var(--card); border: 1px solid var(--red); border-radius: 14px; z-index: 50; font-size: 15px; color: var(--txt2); }
			.f1-vazio b { display: block; color: var(--txt); font-size: 22px; margin-bottom: 6px; }
			
			/* controles */
			.f1-btn { appearance: none; border: 1px solid var(--borda2); background: var(--card2); color: var(--txt); border-radius: 9px; padding: 7px 12px; font-size: 12px; font-weight: 700; cursor: pointer; transition: background .15s, border-color .15s, transform .1s; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
			.f1-btn:hover { border-color: #4A5468; background: #1E2431; }
			.f1-btn:active { transform: translateY(1px); }
			.f1-btn.prim { background: var(--red); border-color: var(--red); color: #fff; }
			.f1-btn.prim:hover { background: var(--red2); }
			.f1-btn:disabled { opacity: .45; cursor: default; }
			.f1-seg { display: inline-flex; background: #0E1118; border: 1px solid var(--borda); border-radius: 9px; padding: 2px; gap: 2px; }
			.f1-seg button { appearance: none; border: 0; background: transparent; color: var(--txt2); font-size: 11px; font-weight: 700; padding: 5px 9px; border-radius: 7px; cursor: pointer; }
			.f1-seg but"
			& "ton.on { background: #262D3C; color: #fff; }
			.f1-seg button:hover:not(.on) { color: var(--txt); }
			.f1-busca { width: 100%; height: 34px; border-radius: 9px; border: 1px solid var(--borda2); background: #0E1118; color: var(--txt); padding: 0 12px 0 32px; font-size: 13px; outline: none;
			  background-image: radial-gradient(circle at 15px 16px, transparent 4.5px, #6B7486 5px, #6B7486 6.3px, transparent 6.8px), linear-gradient(45deg, transparent 47%, #6B7486 47%, #6B7486 60%, transparent 60%);
			  background-size: 34px 34px, 7px 7px; background-position: 0 0, 18px 19px; background-repeat: no-repeat; }
			.f1-busca:focus { border-color: #566078; }
			.f1-select { height: 30px; border-radius: 8px; border: 1px solid var(--borda2); background: #0E1118; color: var(--txt); padding: 0 8px; font-size: 12px; font-weight: 600; outline: none; cursor: pointer; }
			.f1-select option { background: #12161E; }
			.f1-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; background: var(--card2); border: 1px solid var(--borda); white-space: nowrap; }
			.f1-chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--c, #888); }
			
			.f1-scroll { overflow-y: auto; scrollbar-width: thin; scrollbar-color: #2F3646 transparent; }
			.f1-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
			.f1-scroll::-webkit-scrollbar-thumb { background: #2F3646; border-radius: 4px; }
			
			.f1-flag { width: 18px; height: 12px; object-fit: cover; border-radius: 2px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .12); vertical-align: -1px; }
			
			/* avatar com iniciais por baixo da foto */
			.f1-av { position: relative; width: 40px; height: 40px; border-radius: 50%; overflow: hidden; flex: none;
			  background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, .25), transparent 55%), linear-gradient(160deg, var(--c), #0B0D12 130%);
			  box-shadow: 0 0 0 2px var(--c), 0 0 0 3px rgba(0, 0, 0, .5); display: grid; place-items: center; }
			.f1-av span { font-weight: 900; color: #fff; font-size: 14px; letter-spacing: .5px; text-shadow: 0 1px 3px rgba(0, 0, 0, .5); }
			.f1-av img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; background: #1A1F2A; }
			.f1-av.mini { width: 26px; height: 26px; box-shadow: 0 0 0 1.5px var(--c); }
			.f1-av.mini span { font-size: 9px; }
			.f1-av.medio { width: 64px; height: 64px; }
			.f1-av.medio span { font-size: 20px; }
			.f1-av.grande { width: 200px; height: 200px; box-shadow: 0 0 0 4px var(--c), 0 0 40px var(--c); }
			.f1-av.grande span { font-size: 64px; }
			
			.f1-tip { position: absolute; display: none; z-index: 9999; pointer-events: none; max-width: 280px; padding: 8px 10px; border-radius: 9px; background: rgba(14, 17, 24, .97); border: 1px solid var(--borda2); box-shadow: 0 8px 24px rgba(0, 0, 0, .45); font-size: 12px; color: var(--txt); }
			.f1-tip b { color: #fff; }
			.f1-tip small { color: var(--txt2); display: block; }
			
			/* seletor com busca */
			.f1-sel { position: relative; }
			.f1-sel-btn { width: 100%; display: flex; align-items: center; gap: 10px; padding: 6px 10px; border-radius: 11px; border: 1px solid var(--borda2); border-left: 4px solid var(--c); background: #0E1118; color: var(--txt); cursor: pointer; text-align: left; }
			.f1-sel-btn:hover { border-color: #4A5468; border-left-color: var(--c); }
			.f1-sel-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.f1-sel-txt b { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.f1-sel-txt small { color: var(--txt2); font-size: 11px; }
			.f1-sel-seta { width: 8px; height: 8px; border-right: 2px solid var(--txt2); border-bottom: 2px solid var(--txt2); transform: rotate(45deg) translateY(-3px); }
			.f1-sel-pop { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 500; background: #10141C; border: 1px solid var(--borda2); border-radius: 12px; padding: 8px; box-shadow: 0 16px 40px rgba(0, 0, 0, .55); }
			.f1-sel-lista { max-height: 320px; margi"
			& "n-top: 6px; }
			.f1-sel-it { display: flex; align-items: center; gap: 9px; padding: 6px 8px; border-radius: 8px; cursor: pointer; border-left: 3px solid var(--c); margin-bottom: 2px; }
			.f1-sel-it:hover { background: #1A2030; }
			.f1-sel-it.on { background: #232B3C; }
			.f1-sel-it span { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.f1-sel-it b { font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.f1-sel-it small { color: var(--txt2); font-size: 10.5px; }
			.f1-sel-it em { font-style: normal; color: var(--txt2); font-weight: 700; font-size: 11px; }
			.f1-sel-nada { padding: 14px; color: var(--txt3); text-align: center; }
			
			@keyframes f1-entra { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
			.f1-entra { animation: f1-entra .35s ease both; }
			@keyframes f1-pulso { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
			
			.te-anos { left: 16px; top: 58px; width: 1248px; height: 40px; display: flex; gap: 6px; overflow-x: auto; overflow-y: hidden; padding: 4px 2px; }
			.te-ano { appearance: none; flex: none; border: 1px solid var(--borda2); background: var(--card); color: var(--txt2); font-weight: 700; font-size: 13px; padding: 4px 14px; border-radius: 9px; cursor: pointer; position: relative; border-bottom: 3px solid var(--c); }
			.te-ano:hover { color: #fff; background: #1A1F2B; }
			.te-ano.on { background: var(--c); color: #fff; border-color: var(--c); text-shadow: 0 1px 4px rgba(0, 0, 0, .55); }
			.te-ano i { position: absolute; top: -3px; right: 3px; color: var(--ok); font-style: normal; font-size: 18px; line-height: 1; animation: f1-pulso 1.4s infinite; }
			
			.te-corrida { left: 16px; top: 108px; width: 820px; height: 596px; padding: 14px 18px; }
			.te-cab { display: flex; align-items: center; gap: 16px; height: 52px; }
			.te-rodada { width: 78px; height: 52px; border-radius: 10px; background: var(--red); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; }
			.te-rodada small { font-size: 9px; letter-spacing: 1.5px; font-weight: 700; opacity: .85; }
			.te-rodada b { font-size: 26px; font-weight: 900; }
			.te-rodada b small { font-size: 12px; letter-spacing: 0; opacity: .75; }
			.te-gp { flex: 1; display: flex; flex-direction: column; }
			.te-gp b { font-size: 20px; font-weight: 900; display: flex; align-items: center; gap: 8px; }
			.te-gp b .f1-flag { width: 26px; height: 17px; }
			.te-gp small { color: var(--txt2); font-size: 12px; }
			
			.te-barras { position: relative; height: 444px; margin-top: 16px; --dur: .6s; overflow: hidden; }
			.te-row { position: absolute; left: 0; right: 0; top: 0; height: 40px; display: flex; align-items: center; gap: 10px; transition: transform var(--dur) cubic-bezier(.3, .8, .25, 1), opacity .4s; }
			.te-row.inst { transition: none; }
			.te-row.inst .te-barra { transition: none; }
			.te-pos { width: 22px; text-align: right; font-weight: 900; font-size: 15px; color: var(--txt2); }
			.te-eqi { width: 26px; height: 26px; border-radius: 7px; flex: none; }
			.te-nome { width: 168px; display: flex; flex-direction: column; line-height: 1.15; }
			.te-nome b { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.te-nome small { font-size: 10.5px; color: var(--txt3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.te-trilho { flex: 1; height: 28px; position: relative; }
			.te-barra { height: 100%; border-radius: 0 7px 7px 0; background: linear-gradient(90deg, color-mix(in srgb, var(--c) 55%, #0B0D12), var(--c)); box-shadow: 0 0 18px color-mix(in srgb, var(--c) 35%, transparent); transition: width var(--dur) cubic-bezier(.3, .8, .25, 1); position: relative; min-width: 4px; }
			.te-vit { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font-size: 10.5px; font-weight: 700; color: rgba(255, 255, 255, .85); text-shadow: 0 1px 3px rgba(0, 0, 0, .6); white-space: nowrap; }
			.te-val { width: 82px; font-size: 16px; font-weight: 900; text-align: right; display: flex; flex-di"
			& "rection: column; line-height: 1.05; }
			.te-val small { font-size: 10px; color: var(--txt3); font-weight: 700; }
			.te-row.lider .te-pos { color: #FFD24A; }
			
			.te-ctrl { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
			.te-ctrl .te-play { width: 128px; }
			.te-slider { flex: 1; accent-color: var(--red); }
			.te-nota { font-size: 10.5px; color: var(--txt3); margin-top: 6px; }
			
			.te-campeao { left: 852px; top: 108px; width: 412px; height: 158px; padding: 16px; display: flex; gap: 14px; align-items: center; overflow: hidden; }
			.te-camp-bg { position: absolute !important; inset: 0; background: linear-gradient(120deg, transparent 20%, color-mix(in srgb, var(--c) 40%, transparent)); }
			.te-campeao > *:not(.te-camp-bg) { position: relative; }
			.te-camp-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.te-camp-txt small { font-size: 10px; font-weight: 700; letter-spacing: 1.3px; color: #FFD24A; }
			.te-camp-txt b { font-size: 21px; font-weight: 900; line-height: 1.1; }
			.te-camp-txt span { font-size: 12px; color: var(--txt2); font-weight: 600; }
			.te-camp-txt em { font-style: normal; font-size: 11px; color: var(--txt3); margin-top: 4px; }
			.te-camp-eq { position: absolute !important; right: 14px; bottom: 10px; text-align: right; display: flex; flex-direction: column; border-right: 3px solid var(--c2); padding-right: 8px; }
			.te-camp-eq small { font-size: 9px; color: var(--txt3); letter-spacing: 1px; text-transform: uppercase; font-weight: 700; }
			.te-camp-eq b { font-size: 13px; }
			.te-camp-eq span { font-size: 11px; color: var(--txt2); }
			.te-camp-vazio { color: var(--txt3); padding: 20px; text-align: center; width: 100%; }
			
			.te-cal { left: 852px; top: 278px; width: 412px; height: 426px; padding: 12px; overflow: hidden; }
			.te-cal-n { margin-left: auto; color: var(--txt3); letter-spacing: 0; text-transform: none; font-weight: 600; }
			.te-cal-lista { height: 380px; margin-top: 8px; }
			.te-gp-it { display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 8px; cursor: pointer; }
			.te-gp-it:hover { background: #1A1F2B; }
			.te-gp-it.on { background: #232B3C; box-shadow: inset 3px 0 0 var(--red); }
			.te-gp-it.fut { opacity: .5; }
			.te-gp-it em { width: 18px; text-align: right; font-style: normal; font-weight: 700; color: var(--txt3); font-size: 11px; }
			.te-gp-it span { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.te-gp-it b { font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.te-gp-it small { font-size: 10.5px; color: var(--txt3); }
			.te-gp-it strong { font-size: 12px; font-weight: 900; padding: 2px 7px; border-radius: 5px; background: var(--c); color: #fff; text-shadow: 0 1px 2px rgba(0, 0, 0, .5); }
			.te-gp-it strong.nd { background: transparent; color: var(--txt3); }
			.te-spr { font-style: normal; font-size: 8.5px; font-weight: 900; color: #FFD24A; border: 1px solid #FFD24A; border-radius: 3px; padding: 0 3px; letter-spacing: .5px; vertical-align: 1px; }
			
			.te-det { position: absolute; inset: 0; background: var(--card); padding: 12px; transform: translateX(105%); transition: transform .35s cubic-bezier(.3, .8, .25, 1); z-index: 5; }
			.te-det.aberto { transform: none; }
			.te-det-tit { display: flex; flex-direction: column; align-items: center; margin: -4px 0 4px; text-align: center; }
			.te-det-tit .f1-flag { width: 30px; height: 20px; }
			.te-det-tit b { font-size: 17px; font-weight: 900; margin-top: 4px; }
			.te-det-tit small { color: var(--txt3); }
			.te-podio { display: flex; justify-content: center; align-items: flex-end; gap: 10px; height: 128px; }
			.te-deg { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 92px; }
			.te-deg b { font-size: 13px; }
			.te-bloco { width: 100%; border-radius: 8px 8px 0 0; background: linear-gradient(180deg, var(--c), color-mix(in srgb, var(--c) 30%, #0B0D12)); display: grid; place-items: center; font-weight: 900; font-size: 22px; }
			.te-deg.p1 .te-bloco { height: 46px; }
			.te-deg.p2 .te-bloco { height: 32px; }
			."
			& "te-deg.p3 .te-bloco { height: 22px; }
			.te-deg .f1-av.medio { width: 44px; height: 44px; }
			.te-deg .f1-av.medio span { font-size: 15px; }
			.te-det-lista { margin-top: 6px; }
			.te-det-lista div { display: flex; align-items: center; gap: 8px; font-size: 12px; padding: 2px 4px; }
			.te-det-lista em { width: 16px; text-align: right; font-style: normal; color: var(--txt3); font-weight: 700; }
			.te-det-lista i { width: 4px; height: 14px; border-radius: 2px; }
			.te-det-lista span { flex: 1; }
			.te-det-lista small { color: var(--ok); font-weight: 700; }
			.te-det-rod { margin-top: 8px; font-size: 11px; color: var(--txt3); text-align: center; }
			.te-det-rod b { color: var(--txt); }
			"
		displayFolder: <HTML>\CSS
		lineageTag: d8671c15-b724-4dac-a149-bea5b2b389fd

	measure '<HTML> Circuitos' =
			
			VAR _dados = [JS Dados]
			VAR _motor =
			"/* F1 Analytics - nucleo comum a todas as paginas em JavaScript.
			   Le window.F1_DADOS (gerado pela medida [JS Dados]), monta indices e oferece utilitarios.
			   Regra do projeto: nenhum arquivo .js pode conter aspas duplas (o build verifica). */
			(function () {
			  'use strict';
			  const W = window;
			  if (W.F1 && typeof W.F1.destruir === 'function') { try { W.F1.destruir(); } catch (e) { /* ignora */ } }
			  const D = W.F1_DADOS || {};
			  const F1 = { D: D, vivo: true };
			  W.F1 = F1;
			
			  // ---------- ciclo de vida (o visual re-executa o script a cada atualizacao) ----------
			  const timers = [], ouvintes = [];
			  F1.intervalo = (fn, ms) => { const id = setInterval(fn, ms); timers.push(id); return id; };
			  F1.espera = (fn, ms) => { const id = setTimeout(fn, ms); timers.push(id); return id; };
			  F1.parar = (id) => { clearInterval(id); clearTimeout(id); };
			  F1.ouvir = (alvo, ev, fn, opc) => { alvo.addEventListener(ev, fn, opc); ouvintes.push([alvo, ev, fn, opc]); };
			  F1.anim = (fn) => {
			    const loop = (t) => { if (!F1.vivo) return; if (fn(t) !== false) requestAnimationFrame(loop); };
			    requestAnimationFrame(loop);
			  };
			  F1.destruir = () => {
			    F1.vivo = false;
			    timers.forEach((id) => { clearInterval(id); clearTimeout(id); });
			    ouvintes.forEach(([a, e, f, o]) => a.removeEventListener(e, f, o));
			  };
			
			  // ---------- armazenamento local (pode nao existir dentro do visual) ----------
			  const memoria = {};
			  F1.ler = (k, padrao) => {
			    try { const v = W.localStorage.getItem('f1a.' + k); if (v != null) return JSON.parse(v); } catch (e) { /* sem storage */ }
			    return k in memoria ? memoria[k] : padrao;
			  };
			  F1.gravar = (k, v) => { memoria[k] = v; try { W.localStorage.setItem('f1a.' + k, JSON.stringify(v)); } catch (e) { /* sem storage */ } };
			
			  // ---------- cores ----------
			  const hslHex = (h, s, l) => {
			    s /= 100; l /= 100;
			    const k = (n) => (n + h / 30) % 12, a = s * Math.min(l, 1 - l);
			    const f = (n) => Math.round(255 * (l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1))))).toString(16).padStart(2, '0');
			    return '#' + f(0) + f(8) + f(4);
			  };
			  const corHash = (txt) => { let h = 0; for (const ch of String(txt)) h = (h * 31 + ch.charCodeAt(0)) >>> 0; return hslHex(h % 360, 62, 56); };
			  F1.corHash = corHash;
			  F1.rgb = (hex) => { const h = String(hex || '#888888').replace('#', ''); const n = parseInt(h.length === 3 ? h.split('').map((c) => c + c).join('') : h, 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };
			  F1.alfa = (hex, a) => { const [r, g, b] = F1.rgb(hex); return `rgba(${r},${g},${b},${a})`; };
			  F1.luz = (hex) => { const [r, g, b] = F1.rgb(hex); return (0.299 * r + 0.587 * g + 0.114 * b) / 255; };
			  F1.contraste = (hex) => (F1.luz(hex) > 0.6 ? '#0B0D12' : '#FFFFFF');
			  F1.distCor = (a, b) => { const x = F1.rgb(a), y = F1.rgb(b); return Math.hypot(x[0] - y[0], x[1] - y[1], x[2] - y[2]); };
			
			  // ---------- dados ----------
			  const pilotos = new Map(), equipes = new Map(), circuitos = new Map(), corridas = new Map();
			  (D.pl || []).forEach((a) => {
			    const nome = a[4] || '', sob = a[5] || '';
			    pilotos.set(a[0], {
			      k: a[0], id: a[1], cod: a[2] || sob.normalize('NFD').replace(/[̀-ͯ]/g, '').slice(0, 3).toUpperCase(),
			      num: a[3] || '', nome: nome, sobrenome: sob, completo: (nome + ' ' + sob).trim(), nasc: a[6] || '', nac: a[7] || '', foto: a[8] || ''
			    });
			  });
			  (D.eq || []).forEach((a) => equipes.set(a[0], { k: a[0], id: a[1], nome: a[2], nac: a[3], cor: a[4] || corHash(a[1]) }));
			  (D.ci || []).forEach((a) => circuitos.set(a[0], { k: a[0], id: a[1], nome: a[2], cidade: a[3], pais: a[4], lat: +a[5], lng: +a[6] }));
			  (D.co || []).forEach((a) => corridas.set(a[0], {
			    k: a[0], ano: Math.floor(a[0] / 100), rod: a[0] % 100, circ: a[1], gp: a[2], data: a[3], voltas: a[4] || 0, tempo: a[5] || 0
			  }));
			  const resultados = (D.rs || []).map((a) => ({ c: a[0], ano: Math.floor(a[0] / 100), p: a[1], e: a[2], grid: a[3], pos: a[4], pts: +a[5], st: a[6], vr: a[7] }));
			  con"
			& "st sprints = (D.sp || []).map((a) => ({ c: a[0], ano: Math.floor(a[0] / 100), p: a[1], e: a[2], pos: a[3], pts: +a[4] }));
			  const vitorias = (D.vi || []).map((a) => ({ c: a[0], ano: Math.floor(a[0] / 100), p: a[1], e: a[2], grid: a[3] }));
			  const classP = (D.cp || []).map((a) => ({ ano: a[0], rod: a[1], pos: a[2], p: a[3], e: a[4], pts: +a[5], vit: a[6] }));
			  const classE = (D.ce || []).map((a) => ({ ano: a[0], rod: a[1], pos: a[2], e: a[3], pts: +a[4], vit: a[5] }));
			  const hist = (D.ch || []).map((a) => ({ ano: a[0], nome: a[1], equipe: a[2], p: a[3] }));
			
			  const agrupar = (lista, chave) => {
			    const m = new Map();
			    lista.forEach((x) => { const k = chave(x); let g = m.get(k); if (!g) m.set(k, (g = [])); g.push(x); });
			    return m;
			  };
			  F1.agrupar = agrupar;
			  const resPorPiloto = agrupar(resultados, (r) => r.p);
			  const resPorCorrida = agrupar(resultados, (r) => r.c);
			  resPorCorrida.forEach((l) => l.sort((a, b) => a.pos - b.pos));
			  const spPorPiloto = agrupar(sprints, (r) => r.p);
			  const spPorCorrida = agrupar(sprints, (r) => r.c);
			  const corridasPorAno = agrupar([...corridas.values()], (c) => c.ano);
			  corridasPorAno.forEach((l) => l.sort((a, b) => a.rod - b.rod));
			  const corridasPorCircuito = agrupar([...corridas.values()], (c) => c.circ);
			  const vitPorPiloto = agrupar(vitorias, (v) => v.p);
			  const vitPorCorrida = agrupar(vitorias, (v) => v.c);
			
			  Object.assign(F1, {
			    pilotos, equipes, circuitos, corridas, resultados, sprints, vitorias, classP, classE, hist,
			    resPorPiloto, resPorCorrida, spPorPiloto, spPorCorrida, corridasPorAno, corridasPorCircuito, vitPorPiloto, vitPorCorrida
			  });
			
			  const anos = [...new Set(resultados.map((r) => r.ano))].sort((a, b) => a - b);
			  F1.anos = anos;
			  F1.periodo = anos.length ? [anos[0], anos[anos.length - 1]] : [0, 0];
			  F1.periodoTexto = !anos.length ? 'sem dados' : anos[0] === anos[anos.length - 1] ? String(anos[0]) : anos[0] + '–' + anos[anos.length - 1];
			
			  // classificacao final disponivel por temporada
			  const finalP = agrupar(classP, (x) => x.ano), finalE = agrupar(classE, (x) => x.ano);
			  finalP.forEach((l) => l.sort((a, b) => (a.pos || 999) - (b.pos || 999)));
			  finalE.forEach((l) => l.sort((a, b) => (a.pos || 999) - (b.pos || 999)));
			  F1.finalP = finalP; F1.finalE = finalE;
			  const ultimaRodada = (ano) => { const l = corridasPorAno.get(ano); return l && l.length ? l[l.length - 1].rod : 0; };
			  F1.ultimaRodada = ultimaRodada;
			  F1.temporadaCompleta = (ano) => { const l = finalP.get(ano); return !!(l && l.length && l[0].rod >= ultimaRodada(ano)); };
			  F1.corridaRealizada = (c) => resPorCorrida.has(c);
			
			  // campeoes: tabela historica + classificacao final da API (que prevalece)
			  const norm = (s) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z]/g, '');
			  F1.norm = norm;
			  const porNome = new Map();
			  pilotos.forEach((p) => { if (!porNome.has(norm(p.completo))) porNome.set(norm(p.completo), p.k); });
			  const campeoes = new Map();
			  hist.forEach((h) => campeoes.set(h.ano, { ano: h.ano, p: h.p > 0 ? h.p : porNome.get(norm(h.nome)) || 0, nome: h.nome, equipe: h.equipe, e: 0 }));
			  finalP.forEach((l, ano) => {
			    if (!F1.temporadaCompleta(ano) || !l[0] || l[0].pos !== 1) return;
			    const p = pilotos.get(l[0].p), e = equipes.get(l[0].e);
			    campeoes.set(ano, { ano: ano, p: l[0].p, nome: p ? p.completo : '', equipe: e ? e.nome : '', e: l[0].e });
			  });
			  F1.campeoes = campeoes;
			  F1.campeoesEq = new Map();
			  finalE.forEach((l, ano) => { if (F1.temporadaCompleta(ano) && l[0] && l[0].pos === 1) F1.campeoesEq.set(ano, l[0].e); });
			  const titulos = new Map();
			  campeoes.forEach((c) => { if (c.p) { if (!titulos.has(c.p)) titulos.set(c.p, []); titulos.get(c.p).push(c.ano); } });
			  titulos.forEach((l) => l.sort((a, b) => a - b));
			  F1.titulos = (p) => titulos.get(p) || [];
			  F1.vitoriasCarreira = (p) => (vitPorPiloto.get(p) || []).length;
			
			  // ---------- consultas ----------
			  F1.p = (k) => pilotos.get(k) || { k: k, cod: '???"
			& "', nome: '', sobrenome: '?', completo: '?', num: '', nac: '', foto: '' };
			  F1.e = (k) => equipes.get(k) || { k: k, id: '', nome: '—', nac: '', cor: '#777777' };
			  F1.equipeDoPiloto = (p, ano) => {
			    const l = (resPorPiloto.get(p) || []).filter((r) => !ano || r.ano === ano);
			    if (l.length) return l.reduce((a, b) => (b.c > a.c ? b : a)).e;
			    const v = vitPorPiloto.get(p);
			    return v && v.length ? v[v.length - 1].e : 0;
			  };
			  F1.corPiloto = (p, ano) => F1.e(F1.equipeDoPiloto(p, ano)).cor;
			  F1.pilotosDoPeriodo = (ano) => {
			    const s = new Set();
			    resultados.forEach((r) => { if (!ano || r.ano === ano) s.add(r.p); });
			    return [...s];
			  };
			
			  const cacheEst = new Map();
			  F1.estat = (p, ano) => {
			    const chave = p + '|' + (ano || 0);
			    if (cacheEst.has(chave)) return cacheEst.get(chave);
			    const lista = (resPorPiloto.get(p) || []).filter((r) => !ano || r.ano === ano);
			    const sps = (spPorPiloto.get(p) || []).filter((r) => !ano || r.ano === ano);
			    const s = { largadas: 0, vit: 0, pod: 0, pol: 0, pts: 0, dnf: 0, dsq: 0, vr: 0, nosPontos: 0, melhor: 0, nMelhor: 0, mediaPos: NaN, mediaGrid: NaN, ganho: 0, pontosPct: 0, anos: [], equipes: [] };
			    let somaPos = 0, nPos = 0, somaGrid = 0, nGrid = 0, somaGanho = 0, nGanho = 0, melhor = 99;
			    const anosSet = new Set(), eqMap = new Map();
			    lista.forEach((r) => {
			      s.pts += r.pts;
			      if (r.st === 4) return; // nao largou
			      s.largadas++;
			      anosSet.add(r.ano);
			      if (!eqMap.has(r.e)) eqMap.set(r.e, new Set());
			      eqMap.get(r.e).add(r.ano);
			      const cls = r.st <= 1;
			      if (r.pos === 1 && cls) s.vit++;
			      if (r.pos <= 3 && cls) s.pod++;
			      if (r.grid === 1) s.pol++;
			      if (r.vr) s.vr++;
			      if (r.st === 2) s.dnf++;
			      if (r.st === 3) s.dsq++;
			      if (r.pts > 0) s.nosPontos++;
			      if (r.grid > 0) { somaGrid += r.grid; nGrid++; }
			      if (cls) {
			        somaPos += r.pos; nPos++;
			        if (r.pos < melhor) { melhor = r.pos; s.nMelhor = 0; }
			        if (r.pos === melhor) s.nMelhor++;
			        if (r.grid > 0) { somaGanho += r.grid - r.pos; nGanho++; }
			      }
			    });
			    sps.forEach((r) => { s.pts += r.pts; });
			    s.melhor = melhor === 99 ? 0 : melhor;
			    s.mediaPos = nPos ? somaPos / nPos : NaN;
			    s.mediaGrid = nGrid ? somaGrid / nGrid : NaN;
			    s.ganho = nGanho ? somaGanho / nGanho : 0;
			    s.pontosPct = s.largadas ? s.nosPontos / s.largadas : 0;
			    s.anos = [...anosSet].sort((a, b) => a - b);
			    s.equipes = [...eqMap.entries()].map(([e, a]) => ({ e: e, anos: [...a].sort((x, y) => x - y) })).sort((a, b) => a.anos[0] - b.anos[0]);
			    cacheEst.set(chave, s);
			    return s;
			  };
			
			  // atributos 40-99 por percentil entre os pilotos com amostra minima no periodo
			  let cacheAtr = null;
			  F1.ATRIBUTOS = [
			    ['cla', 'Classificação', 'Posição média de largada'],
			    ['cor', 'Ritmo de corrida', 'Posição média de chegada (classificado)'],
			    ['ult', 'Ultrapassagem', 'Posições ganhas por corrida'],
			    ['con', 'Regularidade', '% de corridas nos pontos'],
			    ['cnf', 'Confiabilidade', '% de corridas sem abandono'],
			    ['exp', 'Experiência', 'Largadas no período']
			  ];
			  F1.atributos = (p) => {
			    if (!cacheAtr) {
			      cacheAtr = new Map();
			      const base = [];
			      pilotos.forEach((pp) => { const s = F1.estat(pp.k); if (s.largadas >= 10 && !isNaN(s.mediaPos)) base.push([pp.k, s]); });
			      if (base.length < 6) pilotos.forEach((pp) => { const s = F1.estat(pp.k); if (s.largadas > 0 && s.largadas < 10 && !isNaN(s.mediaPos)) base.push([pp.k, s]); });
			      const f = {
			        cla: (s) => -(isNaN(s.mediaGrid) ? 22 : s.mediaGrid), cor: (s) => -s.mediaPos, ult: (s) => s.ganho,
			        con: (s) => s.pontosPct, cnf: (s) => 1 - (s.dnf + s.dsq) / Math.max(1, s.largadas), exp: (s) => s.largadas
			      };
			      const ord = {};
			      Object.keys(f).forEach((m) => { ord[m] = base.map(([, s]) => f[m](s)).sort((a, b) => a - b); });
			      const pct = (arr, v) => {
			        let menor = 0, igual = 0;
			        arr.forEach((x) => { if (x <"
			& " v) menor++; else if (x === v) igual++; });
			        return arr.length > 1 ? (menor + igual / 2 - 0.5) / (arr.length - 1) : 0.5;
			      };
			      base.forEach(([k, s]) => {
			        const o = {};
			        Object.keys(f).forEach((m) => { o[m] = Math.round(40 + 59 * Math.max(0, Math.min(1, pct(ord[m], f[m](s))))); });
			        o.geral = Math.round(o.cla * 0.22 + o.cor * 0.3 + o.ult * 0.08 + o.con * 0.22 + o.cnf * 0.08 + o.exp * 0.1);
			        cacheAtr.set(k, o);
			      });
			    }
			    return cacheAtr.get(p) || null;
			  };
			
			  // pontos acumulados por rodada (corrida + sprint) de uma temporada
			  F1.pontosAcumulados = (ano, porEquipe) => {
			    const rodadas = (corridasPorAno.get(ano) || []).filter((c) => resPorCorrida.has(c.k));
			    const tot = new Map(), vit = new Map(), quadros = [];
			    rodadas.forEach((c) => {
			      const soma = (r) => {
			        const k = porEquipe ? r.e : r.p;
			        tot.set(k, (tot.get(k) || 0) + r.pts);
			      };
			      (resPorCorrida.get(c.k) || []).forEach((r) => {
			        soma(r);
			        const k = porEquipe ? r.e : r.p;
			        if (!tot.has(k)) tot.set(k, 0);
			        if (r.pos === 1 && r.st <= 1) vit.set(k, (vit.get(k) || 0) + 1);
			      });
			      (spPorCorrida.get(c.k) || []).forEach(soma);
			      quadros.push({ corrida: c, pts: new Map(tot), vit: new Map(vit) });
			    });
			    return quadros;
			  };
			
			  // ---------- nacionalidades e paises ----------
			  const NAC = {
			    British: ['gb', 'Reino Unido'], English: ['gb', 'Reino Unido'], Scottish: ['gb', 'Reino Unido'], Dutch: ['nl', 'Holanda'], Spanish: ['es', 'Espanha'],
			    Monegasque: ['mc', 'Mônaco'], Mexican: ['mx', 'México'], Australian: ['au', 'Austrália'], French: ['fr', 'França'], German: ['de', 'Alemanha'],
			    'East German': ['de', 'Alemanha'], 'West German': ['de', 'Alemanha'], Finnish: ['fi', 'Finlândia'], Canadian: ['ca', 'Canadá'],
			    Danish: ['dk', 'Dinamarca'], Japanese: ['jp', 'Japão'], Thai: ['th', 'Tailândia'], Chinese: ['cn', 'China'], American: ['us', 'EUA'],
			    'American-Italian': ['us', 'EUA'], Italian: ['it', 'Itália'], 'New Zealander': ['nz', 'Nova Zelândia'], Brazilian: ['br', 'Brasil'],
			    Argentine: ['ar', 'Argentina'], Argentinian: ['ar', 'Argentina'], 'Argentine-Italian': ['ar', 'Argentina'], Belgian: ['be', 'Bélgica'],
			    Swedish: ['se', 'Suécia'], Swiss: ['ch', 'Suíça'], Austrian: ['at', 'Áustria'], Russian: ['ru', 'Rússia'], Polish: ['pl', 'Polônia'],
			    Venezuelan: ['ve', 'Venezuela'], Indonesian: ['id', 'Indonésia'], Indian: ['in', 'Índia'], Colombian: ['co', 'Colômbia'],
			    Portuguese: ['pt', 'Portugal'], 'South African': ['za', 'África do Sul'], Hungarian: ['hu', 'Hungria'], Irish: ['ie', 'Irlanda'],
			    Czech: ['cz', 'Tchéquia'], Malaysian: ['my', 'Malásia'], Rhodesian: ['zw', 'Rodésia'], Uruguayan: ['uy', 'Uruguai'], Chilean: ['cl', 'Chile'],
