			    const ini = performance.now(), d = dur || 700, alvo = +valor || 0;
			    if (!alvo) { el.textContent = F1.fmt(0, dec); return; }
			    F1.anim((t) => {
			      const k = Math.min(1, (t - ini) / d), "
