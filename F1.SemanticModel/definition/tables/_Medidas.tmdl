			    const caminho = (s) => { let d = '', ok = false; s.forEach((v, i) => { if (v == null) { ok = false; return; } d += (ok ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(v).toFixed(1); ok = true; }); return d; };
