			.pl-hero { left: 324px; top: 60px; width: 560px; height: 300px; border-radius: 16px; overflow: hidden; border: 1px solid var(--borda); background: #0E1118; }
			.pl-h-bg { position: absolute; inset: 0; background: linear-gradient(115deg, #0E1118 18%, color-mix(in srgb, var(--c) 55%, #0E1118) 70%, var(--c) 130%); }
			.pl-h-bg::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(115deg, rgba(255, 255, 255, .035) 0 1px, transparent 1px 9px); }
			.pl-h-linhas i { position: absolute; right: -200px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .55)); animation: pl-vel 1.6s linear infinite; opacity: .5; }
			@keyframes pl-vel { from { transform: translateX(0); } to { transform: translateX(-900px); } }
			.pl-h-num { position: absolute; right: 18px; bottom: -40px; font-size: 230px; font-weight: 900; font-style: italic; line-height: 1; color: rgba(255, 255, 255, .09); letter-spacing: -8px; }
			.pl-h-foto { position: absolute; right: 44px; top: 48px; }
