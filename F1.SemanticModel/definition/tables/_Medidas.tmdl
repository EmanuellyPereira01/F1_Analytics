			  // ---------- componentes ----------
			  F1.iniciais = (p) => { const pi = F1.p(p); return ((pi.nome[0] || '') + (pi.sobrenome[0] || '')).toUpperCase(); };
			  F1.avatar = (p, cls, ano) => {
