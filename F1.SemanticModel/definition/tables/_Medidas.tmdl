			    Portugal: ['pt', 'Portugal'], Russia: ['ru', 'Rússia'], Turkey: ['tr', 'Turquia'], Malaysia: ['my', 'Malásia'], Korea: ['kr', 'Coreia do Sul'],
			    India: ['in', 'Índia'], Argentina: ['ar', 'Argentina'], 'South Africa': ['za', 'África do Sul'], Sweden: ['se', 'Su"
			& "écia'], Switzerland: ['ch', 'Suíça'],
