			          const chance = pit ? 0 : Math.max(0, Math.min(0.8, vant * 0.5 + (c.ritmo - frente.ritmo) * 0.9 - 0.08));
			          if (r() < chance) ev.push({ tipo: 'ult', id: c.id, sobre: frente.id, volta: n });
			          else novo = frente.t + gapMin + r() * 0.25;
