			    const w = W.innerWidth, h = W.innerHeight, r = tip.getBoundingClientRect();
			    let x = ev.clientX + 14, y = ev.clientY + 14;
			    if (x + r.width > w - 4) x = ev.clientX - r.width - 12;
			    if (y + r.height > h - 4) y = ev.clientY - r.height - 12;
