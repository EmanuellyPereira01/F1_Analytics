			.pl-kpi em { font-style: normal; font-size: 10.5px; color: var(--txt3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			
			.pl-radar { left: 900px; top: 60px; width: 364px; height: 330px; padding: 12px 0 0; }
