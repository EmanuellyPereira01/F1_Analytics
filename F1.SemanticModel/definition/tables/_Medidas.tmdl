			.pl-geral { position: absolute; right: 12px; top: -26px; width: 58px; height: 58px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(150deg, var(--c), #0B0D12 140%); box-shadow: 0 6px 18px rgba(0, 0, 0, .4); }
			.pl-geral b { font-size: 26px; font-weight: 900; line-height: 1; }
