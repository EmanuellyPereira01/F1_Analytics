			        `<small class='${ganho > 0 ? 'sobe' : ganho < 0 ? 'desce' : ''}'>${ganho > 0 ? '▲' + ganho : ganho < 0 ? '▼' + -ganho : ''}</small><span>${gap}</span>` +
