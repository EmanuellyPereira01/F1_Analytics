			})();
			
			/* Pagina Quiz: quatro tipos de pergunta gerados a partir dos dados, cronometro, sequencia e recorde. */
			(function () {
			  'use strict';
			  const F1 = window.F1;
			  const palco = F1.palco('Quiz', 'Quanto você sabe de F1?');
			  palco.insertAdjacentHTML('beforeend', `<section class='qz-caixa f1-cartao'></section><aside class='qz-lado f1-cartao'></aside>`);
			  const $ = (s) => palco.querySelector(s);
			  const TOTAL = 10, TEMPO = 15;
			  const MODOS = [
			    ['misto', 'Misto', 'Um pouco de tudo'],
			    ['piloto', 'Quem é esse piloto?', 'Pistas reveladas aos poucos'],
			    ['vencedor', 'Quem venceu?', 'Vencedores de GPs do período'],
			    ['equipe', 'Qual equipe?', 'Por quem o piloto correu'],
			    ['campeao', 'Campeões', 'Todos os campeões desde 1950']
			  ];
			  const est = { modo: F1.ler('qz.modo', 'misto'), ano: 0, q: null, n: 0, pontos: 0, acertos: 0, seq: 0, maxSeq: 0, t0: 0, timer: null, respondido: false, hist: [] };
			
			  const elegiveis = (ano) => F1.pilotosDoPeriodo(ano).filter((p) => F1.estat(p, ano).largadas >= (ano ? 3 : 15));
			  const sortear = (arr, r) => arr[Math.floor(r() * arr.length)];
			  const r = Math.random;
			
			  // ---------- geradores de pergunta ----------
			  const G = {
			    piloto: () => {
			      const pool = elegiveis(est.ano);
			      if (pool.length < 4) return null;
			      const p = sortear(pool, r), pi = F1.p(p), s = F1.estat(p, est.ano), e = F1.e(F1.equipeDoPiloto(p, est.ano)), nac = F1.nac(pi.nac);
			      const outros = F1.embaralhar(pool.filter((x) => x !== p), r).slice(0, 3);
			      const pistas = [
			        `${F1.bandeira(nac[0])} Nacionalidade: <b>${F1.esc(nac[1])}</b>`,
			        pi.nasc ? `Nasceu em <b>${pi.nasc.slice(0, 4)}</b>` : `Sigla com <b>${pi.cod.length}</b> letras`,
			        `Correu pela <b style='color:${e.cor}'>${F1.esc(e.nome)}</b>${est.ano ? ' em ' + est.ano : ''}`,
			        `<b>${s.vit}</b> vitórias "
			& "e <b>${s.pod}</b> pódios ${est.ano ? 'em ' + est.ano : 'no período'}`,
			        pi.num ? `Número permanente <b>#${F1.esc(pi.num)}</b>` : `Sigla: <b>${F1.esc(pi.cod)}</b>`
			      ];
			      return { tipo: 'piloto', enun: 'Quem é esse piloto?', certo: p, opcoes: F1.embaralhar([p, ...outros], r), pistas, foto: pi.foto, cor: e.cor };
			    },
			    vencedor: () => {
			      const corr = [...F1.resPorCorrida.keys()].filter((c) => !est.ano || Math.floor(c / 100) === est.ano);
			      if (!corr.length) return null;
			      const c = sortear(corr, r), rs = F1.resPorCorrida.get(c), v = rs[0].p;
			      const outros = F1.embaralhar(rs.slice(1, 8).map((x) => x.p), r).slice(0, 3);
			      if (outros.length < 3) return null;
			      const ci = F1.circuitos.get(F1.corridas.get(c).circ);
			      return {
			        tipo: 'vencedor', enun: `Quem venceu o ${F1.gpNome(c)} de ${Math.floor(c / 100)}?`, certo: v, opcoes: F1.embaralhar([v, ...outros], r),
			        pistas: [`${ci ? F1.bandeiraPais(ci.pais) : ''} ${F1.esc(ci ? ci.nome : '')}`, `Largou em <b>P${rs[0].grid || '—'}</b>`], cor: F1.e(rs[0].e).cor
			      };
			    },
			    equipe: () => {
			      const pool = elegiveis(est.ano);
			      if (!pool.length) return null;
			      const p = sortear(pool, r), anos = F1.estat(p, est.ano).anos, ano = est.ano || sortear(anos, r);
			      const e = F1.equipeDoPiloto(p, ano);
			      const doAno = [...new Set(F1.resultados.filter((x) => x.ano === ano).map((x) => x.e))].filter((x) => x !== e);
			      if (doAno.length < 3) return null;
			      const outras = F1.embaralhar(doAno, r).slice(0, 3);
			      return { tipo: 'equipe', enun: `Por qual equipe ${F1.p(p).completo} correu em ${ano}?`, certo: e, opcoes: F1.embaralhar([e, ...outras], r), piloto: p, ano, pistas: [], cor: F1.e(e).cor };
			    },
			    campeao: () => {
			      const anos = [...F1.campeoes.keys()].filter((a) => F1.campeoes.get(a).nome);
			      if (anos.length < 4) return null;
			      const a = sortear(anos, r), c = F1.campeoes.get(a);
			      const perto = F1.embaralhar(anos.filter((x) => F1.campeoes.get(x).nome !== c.nome).sort((x, y) => Math.abs(x - a) - Math.abs(y - a)).slice(0, 10), r);
			      const nomes = [];
			      perto.forEach((x) => { const n = F1.campeoes.get(x).nome; if (!nomes.includes(n) && nomes.length < 3) nomes.push(n); });
			      return { tipo: 'campeao', enun: `Quem foi o campeão mundial de ${a}?`, certo: c.nome, opcoes: F1.embaralhar([c.nome, ...nomes], r), pistas: [`Pela <b>${F1.esc(c.equipe)}</b>`], cor: '#FFD24A', campeao: c };
			    }
			  };
			  const gerar = () => {
			    for (let i = 0; i < 30; i++) {
			      const tipo = est.modo === 'misto' ? sortear(['piloto', 'vencedor', 'equipe', 'campeao', 'vencedor', 'piloto'], r) : est.modo;
			      const q = G[tipo]();
			      if (q && !est.hist.includes(q.enun + q.certo)) { est.hist.push(q.enun + q.certo); return q; }
			    }
			    return G.campeao() || G.vencedor();
			  };
			
			  // ---------- telas ----------
			  const recorde = () => F1.ler('qz.rec.' + est.modo, 0);
			  const lado = () => {
			    $('.qz-lado').innerHTML = `<div class='f1-rot'>Placar</div>
			      <div class='qz-pl'><small>PONTOS</small><b>${est.pontos}</b></div>
			      <div class='qz-pl'><small>ACERTOS</small><b>${est.acertos}<span>/${Math.max(est.n - (est.respondido ? 0 : 1), 0)}</span></b></div>
			      <div class='qz-pl'><small>SEQUÊNCIA</small><b>${est.seq}${est.seq >= 3 ? ' 🔥' : ''}</b></div>
			      <div class='qz-pl rec'><small>RECORDE (${F1.esc(MODOS.find((m) => m[0] === est.modo)[1])})</small><b>${recorde()}</b></div>
			      <div class='qz-regras'>Acerto vale 100 + bônus de tempo (até 50). Sequências de 3+ acertos dobram o bônus. Atalho: teclas 1 a 4.</div>`;
			  };
			
			  const inicio = () => {
			    F1.parar(est.timer);
			    const anos = F1.anos.slice().reverse().map((a) => `<option value='${a}'${a === est.ano ? ' selected' : ''}>${a}</option>`).join('');
			    $('.qz-caixa').innerHTML = `<div class='qz-ini f1-entra'>
			      <div class='qz-logo'><b>?</b></div><h2>Quiz de Fórmula 1</h2><p>${TOTAL} perguntas · ${TEMPO} segundos cada</p>
			      <div c"
			& "lass='qz-modos'>${MODOS.map(([k, n, d]) => `<button class='qz-modo${k === est.modo ? ' on' : ''}' data-m='${k}'><b>${n}</b><small>${d}</small><em>Recorde ${F1.ler('qz.rec.' + k, 0)}</em></button>`).join('')}</div>
			      <div class='qz-cfg'><span>Temporada</span><select class='f1-select qz-ano'><option value='0'>Período ${F1.periodoTexto}</option>${anos}</select></div>
			      <button class='f1-btn prim qz-go'>Começar ▶</button></div>`;
			    est.n = 0; est.pontos = 0; est.acertos = 0; est.seq = 0; est.maxSeq = 0; est.hist = []; est.respondido = true;
			    lado();
			  };
			
			  const opcaoHtml = (q, o, i) => {
			    if (q.tipo === 'equipe') { const e = F1.e(o); return `<button class='qz-op' data-i='${i}' style='--c:${e.cor}'><kbd>${i + 1}</kbd><i class='qz-eq'></i><b>${F1.esc(e.nome)}</b></button>`; }
			    if (q.tipo === 'campeao') return `<button class='qz-op' data-i='${i}' style='--c:#3A4253'><kbd>${i + 1}</kbd><b>${F1.esc(o)}</b></button>`;
			    const pi = F1.p(o);
			    return `<button class='qz-op' data-i='${i}' style='--c:${F1.corPiloto(o, q.ano || est.ano)}'><kbd>${i + 1}</kbd>${F1.avatar(o, 'mini', q.ano || est.ano)}<b>${F1.esc(pi.completo)}</b></button>`;
			  };
			
			  const pergunta = () => {
			    const q = gerar();
			    if (!q) { $('.qz-caixa').innerHTML = `<div class='qz-ini'><h2>Dados insuficientes</h2><p>Carregue mais temporadas para jogar.</p></div>`; return; }
			    est.q = q; est.n++; est.respondido = false; est.t0 = performance.now();
			    let visual = '';
			    if (q.tipo === 'piloto') visual = `<div class='qz-sil' style='--c:${q.cor}'>${q.foto ? `<img src='${F1.esc(q.foto)}' alt='' onerror='this.remove()'>` : ''}<span>?</span></div>`;
			    else if (q.tipo === 'equipe') visual = `<div class='qz-sil cl'>${F1.avatar(q.piloto, 'grande', q.ano)}</div>`;
			    else if (q.tipo === 'vencedor') visual = `<div class='qz-trofeu'>🏆</div>`;
			    else visual = `<div class='qz-trofeu'>★</div>`;
			    $('.qz-caixa').innerHTML = `<div class='qz-top'><span>Pergunta <b>${est.n}</b>/${TOTAL}</span><div class='qz-tempo'><i></i></div><span class='qz-seg'>${TEMPO}s</span></div>
			      <div class='qz-corpo f1-entra'>${visual}<div class='qz-enun'><h3>${F1.esc(q.enun)}</h3><div class='qz-pistas'>${q.pistas.map((p, i) => `<div class='qz-pista${q.tipo === 'piloto' && i > 0 ? ' oculta' : ''}'>${p}</div>`).join('')}</div></div></div>
			      <div class='qz-ops'>${q.opcoes.map((o, i) => opcaoHtml(q, o, i)).join('')}</div><div class='qz-fb'></div>`;
			    lado();
			    const barra = $('.qz-tempo i'), seg = $('.qz-seg');
			    F1.parar(est.timer);
			    est.timer = F1.intervalo(() => {
			      const t = (performance.now() - est.t0) / 1000, resto = Math.max(0, TEMPO - t);
			      barra.style.width = (resto / TEMPO) * 100 + '%';
			      barra.classList.toggle('alerta', resto < 5);
			      seg.textContent = Math.ceil(resto) + 's';
			      if (q.tipo === 'piloto') palco.querySelectorAll('.qz-pista').forEach((el, i) => { if (t > i * 2.6) el.classList.remove('oculta'); });
			      if (resto <= 0) responder(-1);
			    }, 100);
			  };
			
			  const responder = (i) => {
			    if (est.respondido) return;
			    est.respondido = true;
			    F1.parar(est.timer);
			    const q = est.q, t = (performance.now() - est.t0) / 1000;
			    const certoIdx = q.opcoes.findIndex((o) => o === q.certo), ok = i === certoIdx;
			    let ganho = 0;
			    if (ok) {
			      est.acertos++; est.seq++; est.maxSeq = Math.max(est.maxSeq, est.seq);
			      const bonus = Math.round(50 * Math.max(0, 1 - t / TEMPO));
			      ganho = 100 + (est.seq >= 3 ? bonus * 2 : bonus);
			      est.pontos += ganho;
			    } else est.seq = 0;
			    palco.querySelectorAll('.qz-op').forEach((b, k) => { b.disabled = true; if (k === certoIdx) b.classList.add('certo'); else if (k === i) b.classList.add('errado'); });
			    palco.querySelectorAll('.qz-pista').forEach((el) => el.classList.remove('oculta'));
			    const sil = $('.qz-sil'); if (sil) sil.classList.add('revela');
			    let extra = '';
			    if (q.tipo === 'piloto') extra = F1.esc(F1.p(q.certo).completo);
			    else if (q.tipo === 'equipe') ext"
			& "ra = F1.esc(F1.e(q.certo).nome);
			    else if (q.tipo === 'campeao') extra = F1.esc(q.certo) + ' · ' + F1.esc(q.campeao.equipe);
			    else extra = F1.esc(F1.p(q.certo).completo);
			    $('.qz-fb').innerHTML = `<div class='${ok ? 'ok' : 'nok'}'>${ok ? `Certo! +${ganho}` : i < 0 ? 'Tempo esgotado!' : 'Errou!'} <span>${extra}</span></div>` +
			      `<button class='f1-btn prim qz-prox'>${est.n >= TOTAL ? 'Ver resultado' : 'Próxima ▶'}</button>`;
			    lado();
			  };
			
			  const fim = () => {
			    const rec = recorde(), novo = est.pontos > rec;
			    if (novo) F1.gravar('qz.rec.' + est.modo, est.pontos);
			    const pct = est.acertos / TOTAL;
			    const titulo = pct >= 0.9 ? 'Campeão mundial! 🏆' : pct >= 0.7 ? 'Pódio garantido!' : pct >= 0.5 ? 'Nos pontos' : pct >= 0.3 ? 'Fora dos pontos' : 'Abandono na volta 1';
			    $('.qz-caixa').innerHTML = `<div class='qz-ini f1-entra'><div class='qz-logo fim'><b>${est.acertos}</b></div><h2>${titulo}</h2>
			      <p>${est.acertos} de ${TOTAL} acertos · ${est.pontos} pontos · melhor sequência ${est.maxSeq}</p>
			      ${novo ? `<div class='qz-novo'>★ Novo recorde!</div>` : `<p class='qz-rec'>Recorde: ${rec}</p>`}
			      <div class='qz-fim-bts'><button class='f1-btn prim qz-go'>Jogar de novo</button><button class='f1-btn qz-menu'>Trocar modo</button></div></div>`;
			    lado();
			  };
			
			  $('.qz-caixa').addEventListener('click', (ev) => {
			    const m = ev.target.closest('.qz-modo');
			    if (m) { est.modo = m.getAttribute('data-m'); F1.gravar('qz.modo', est.modo); palco.querySelectorAll('.qz-modo').forEach((x) => x.classList.toggle('on', x === m)); lado(); return; }
			    if (ev.target.closest('.qz-go')) { const s = $('.qz-ano'); if (s) est.ano = +s.value; est.n = 0; est.pontos = 0; est.acertos = 0; est.seq = 0; est.maxSeq = 0; est.hist = []; pergunta(); return; }
			    if (ev.target.closest('.qz-menu')) { inicio(); return; }
			    const op = ev.target.closest('.qz-op');
			    if (op) { responder(+op.getAttribute('data-i')); return; }
			    if (ev.target.closest('.qz-prox')) { if (est.n >= TOTAL) fim(); else pergunta(); }
			  });
			  F1.ouvir(document, 'keydown', (ev) => {
			    if (ev.target && (ev.target.tagName === 'INPUT' || ev.target.tagName === 'SELECT')) return;
			    if (!est.respondido && ev.key >= '1' && ev.key <= '4') responder(+ev.key - 1);
			    else if (est.respondido && ev.key === 'Enter') { const b = $('.qz-prox') || $('.qz-go'); if (b) b.click(); }
			  });
			
			  inicio();
			})();
			"
			RETURN
			    "<div id='app-raiz'></div><script>" & _dados & "</script><script>" & _motor & "</script>"
		displayFolder: <HTML>
		lineageTag: 25ea6d40-951e-4e5a-9575-425e71c77d7a

	measure '<CSS> Quiz' =
			
			"@import url('https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;900&display=swap');
			#app-raiz {
			  --bg: #0A0C10; --card: #12161E; --card2: #181D28; --borda: #242A36; --borda2: #323A4A;
			  --txt: #ECEEF2; --txt2: #9AA3B2; --txt3: #626B7C; --red: #E10600; --red2: #FF3B30; --ok: #2BD47D; --warn: #FFC53D;
			  position: fixed; inset: 0; overflow: hidden; background: var(--bg); color: var(--txt);
			  font-family: 'Titillium Web', 'Segoe UI', system-ui, sans-serif; font-size: 13px; line-height: 1.35;
			  -webkit-font-smoothing: antialiased; user-select: none;
			}
			#app-raiz * { box-sizing: border-box; }
			#app-raiz button, #app-raiz input, #app-raiz select { font-family: inherit; }
			.f1-fundo {
			  position: absolute; inset: 0;
			  background:
			    radial-gradient(900px 420px at 92% -12%, rgba(225, 6, 0, .20), transparent 62%),
			    radial-gradient(700px 400px at -10% 110%, rgba(60, 90, 160, .14), transparent 60%),
			    repeating-linear-gradient(135deg, rgba(255, 255, 255, .018) 0 2px, transparent 2px 7px),
			    var(--bg);
			}
			.f1-palco { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; transform-origin: 0 0; }
			.f1-palco > section, .f1-palco > aside, .f1-palco > div { position: absolute; }
			
			/* topo: o navegador nativo do Power BI fica a esquerda (x 16..616) */
			.f1-topo { position: absolute; left: 640px; right: 16px; top: 10px; height: 36px; display: flex; align-items: center; justify-content: flex-end; gap: 18px; }
			.f1-titulo { display: flex; align-items: baseline; gap: 10px; }
			.f1-tit { font-size: 20px; font-weight: 900; letter-spacing: .5px; text-transform: uppercase; }
			.f1-sub { color: var(--txt2); font-size: 12px; font-weight: 600; }
			.f1-marca { display: flex; align-items: center; gap: 4px; font-weight: 900; font-style: italic; letter-spacing: 1px; font-size: 13px; color: var(--txt2); }
			.f1-marca b { color: #fff; background: var(--red); padding: 0 6px; border-radius: 3px; font-size: 14px; }
			.f1-marca i { width: 18px; height: 3px; background: linear-gradient(90deg, transparent, var(--red)); margin-right: 2px; }
			
			/* blocos */
			.f1-cartao { background: linear-gradient(180deg, rgba(255, 255, 255, .025), transparent 40%), var(--card); border: 1px solid var(--borda); border-radius: 14px; }
			.f1-rot { font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--txt2); display: flex; align-items: center; gap: 8px; }
			.f1-rot::before { content: ''; width: 3px; height: 12px; background: var(--red); border-radius: 2px; }
			.f1-dica { display: inline-grid; place-items: center; width: 15px; height: 15px; border-radius: 50%; border: 1px solid var(--borda2); font-size: 10px; color: var(--txt3); cursor: help; letter-spacing: 0; }
			.f1-vazio { position: absolute; left: 340px; top: 300px; width: 600px; padding: 24px; text-align: center; background: var(--card); border: 1px solid var(--red); border-radius: 14px; z-index: 50; font-size: 15px; color: var(--txt2); }
			.f1-vazio b { display: block; color: var(--txt); font-size: 22px; margin-bottom: 6px; }
			
			/* controles */
			.f1-btn { appearance: none; border: 1px solid var(--borda2); background: var(--card2); color: var(--txt); border-radius: 9px; padding: 7px 12px; font-size: 12px; font-weight: 700; cursor: pointer; transition: background .15s, border-color .15s, transform .1s; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
			.f1-btn:hover { border-color: #4A5468; background: #1E2431; }
			.f1-btn:active { transform: translateY(1px); }
			.f1-btn.prim { background: var(--red); border-color: var(--red); color: #fff; }
			.f1-btn.prim:hover { background: var(--red2); }
			.f1-btn:disabled { opacity: .45; cursor: default; }
			.f1-seg { display: inline-flex; background: #0E1118; border: 1px solid var(--borda); border-radius: 9px; padding: 2px; gap: 2px; }
			.f1-seg button { appearance: none; border: 0; background: transparent; color: var(--txt2); font-size: 11px; font-weight: 700; padding: 5px 9px; border-radius: 7px; cursor: pointer; }
			.f1-seg but"
			& "ton.on { background: #262D3C; color: #fff; }
			.f1-seg button:hover:not(.on) { color: var(--txt); }
			.f1-busca { width: 100%; height: 34px; border-radius: 9px; border: 1px solid var(--borda2); background: #0E1118; color: var(--txt); padding: 0 12px 0 32px; font-size: 13px; outline: none;
			  background-image: radial-gradient(circle at 15px 16px, transparent 4.5px, #6B7486 5px, #6B7486 6.3px, transparent 6.8px), linear-gradient(45deg, transparent 47%, #6B7486 47%, #6B7486 60%, transparent 60%);
			  background-size: 34px 34px, 7px 7px; background-position: 0 0, 18px 19px; background-repeat: no-repeat; }
			.f1-busca:focus { border-color: #566078; }
			.f1-select { height: 30px; border-radius: 8px; border: 1px solid var(--borda2); background: #0E1118; color: var(--txt); padding: 0 8px; font-size: 12px; font-weight: 600; outline: none; cursor: pointer; }
			.f1-select option { background: #12161E; }
			.f1-chip { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; background: var(--card2); border: 1px solid var(--borda); white-space: nowrap; }
			.f1-chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--c, #888); }
			
			.f1-scroll { overflow-y: auto; scrollbar-width: thin; scrollbar-color: #2F3646 transparent; }
			.f1-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
			.f1-scroll::-webkit-scrollbar-thumb { background: #2F3646; border-radius: 4px; }
			
			.f1-flag { width: 18px; height: 12px; object-fit: cover; border-radius: 2px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .12); vertical-align: -1px; }
			
			/* avatar com iniciais por baixo da foto */
			.f1-av { position: relative; width: 40px; height: 40px; border-radius: 50%; overflow: hidden; flex: none;
			  background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, .25), transparent 55%), linear-gradient(160deg, var(--c), #0B0D12 130%);
			  box-shadow: 0 0 0 2px var(--c), 0 0 0 3px rgba(0, 0, 0, .5); display: grid; place-items: center; }
			.f1-av span { font-weight: 900; color: #fff; font-size: 14px; letter-spacing: .5px; text-shadow: 0 1px 3px rgba(0, 0, 0, .5); }
			.f1-av img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; background: #1A1F2A; }
			.f1-av.mini { width: 26px; height: 26px; box-shadow: 0 0 0 1.5px var(--c); }
			.f1-av.mini span { font-size: 9px; }
			.f1-av.medio { width: 64px; height: 64px; }
			.f1-av.medio span { font-size: 20px; }
			.f1-av.grande { width: 200px; height: 200px; box-shadow: 0 0 0 4px var(--c), 0 0 40px var(--c); }
			.f1-av.grande span { font-size: 64px; }
			
			.f1-tip { position: absolute; display: none; z-index: 9999; pointer-events: none; max-width: 280px; padding: 8px 10px; border-radius: 9px; background: rgba(14, 17, 24, .97); border: 1px solid var(--borda2); box-shadow: 0 8px 24px rgba(0, 0, 0, .45); font-size: 12px; color: var(--txt); }
			.f1-tip b { color: #fff; }
			.f1-tip small { color: var(--txt2); display: block; }
			
			/* seletor com busca */
			.f1-sel { position: relative; }
			.f1-sel-btn { width: 100%; display: flex; align-items: center; gap: 10px; padding: 6px 10px; border-radius: 11px; border: 1px solid var(--borda2); border-left: 4px solid var(--c); background: #0E1118; color: var(--txt); cursor: pointer; text-align: left; }
			.f1-sel-btn:hover { border-color: #4A5468; border-left-color: var(--c); }
			.f1-sel-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.f1-sel-txt b { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.f1-sel-txt small { color: var(--txt2); font-size: 11px; }
			.f1-sel-seta { width: 8px; height: 8px; border-right: 2px solid var(--txt2); border-bottom: 2px solid var(--txt2); transform: rotate(45deg) translateY(-3px); }
			.f1-sel-pop { position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 500; background: #10141C; border: 1px solid var(--borda2); border-radius: 12px; padding: 8px; box-shadow: 0 16px 40px rgba(0, 0, 0, .55); }
			.f1-sel-lista { max-height: 320px; margi"
			& "n-top: 6px; }
			.f1-sel-it { display: flex; align-items: center; gap: 9px; padding: 6px 8px; border-radius: 8px; cursor: pointer; border-left: 3px solid var(--c); margin-bottom: 2px; }
			.f1-sel-it:hover { background: #1A2030; }
			.f1-sel-it.on { background: #232B3C; }
			.f1-sel-it span { flex: 1; min-width: 0; display: flex; flex-direction: column; }
			.f1-sel-it b { font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.f1-sel-it small { color: var(--txt2); font-size: 10.5px; }
			.f1-sel-it em { font-style: normal; color: var(--txt2); font-weight: 700; font-size: 11px; }
			.f1-sel-nada { padding: 14px; color: var(--txt3); text-align: center; }
			
			@keyframes f1-entra { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
			.f1-entra { animation: f1-entra .35s ease both; }
			@keyframes f1-pulso { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
			
			.qz-caixa { left: 16px; top: 60px; width: 960px; height: 644px; padding: 22px 28px; overflow: hidden; }
			.qz-lado { left: 992px; top: 60px; width: 272px; height: 644px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
			.qz-pl { background: #0E1118; border: 1px solid var(--borda); border-radius: 12px; padding: 10px 14px; display: flex; flex-direction: column; }
			.qz-pl small { font-size: 10px; letter-spacing: 1.4px; color: var(--txt2); font-weight: 700; }
			.qz-pl b { font-size: 32px; font-weight: 900; line-height: 1.1; }
			.qz-pl b span { font-size: 16px; color: var(--txt3); }
			.qz-pl.rec { border-color: #5A4A1A; background: linear-gradient(140deg, rgba(255, 210, 74, .12), transparent); }
			.qz-pl.rec b { color: #FFD24A; }
			.qz-regras { margin-top: auto; font-size: 11px; color: var(--txt3); line-height: 1.5; }
			
			.qz-ini { display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: 18px; }
			.qz-logo { width: 84px; height: 84px; border-radius: 22px; background: linear-gradient(150deg, var(--red), #5A0300); display: grid; place-items: center; transform: rotate(-6deg); box-shadow: 0 12px 30px rgba(225, 6, 0, .35); }
			.qz-logo b { font-size: 50px; font-weight: 900; transform: rotate(6deg); }
			.qz-logo.fim { background: linear-gradient(150deg, #FFD24A, #8A6400); }
			.qz-ini h2 { margin: 18px 0 2px; font-size: 30px; font-weight: 900; }
			.qz-ini p { margin: 0; color: var(--txt2); font-size: 14px; }
			.qz-modos { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin: 26px 0 18px; width: 100%; }
			.qz-modo { appearance: none; border: 1px solid var(--borda2); background: #0E1118; color: var(--txt); border-radius: 14px; padding: 16px 10px; cursor: pointer; display: flex; flex-direction: column; gap: 4px; align-items: center; transition: transform .12s, border-color .12s; }
			.qz-modo:hover { transform: translateY(-2px); border-color: #4A5468; }
			.qz-modo.on { border-color: var(--red); background: linear-gradient(180deg, rgba(225, 6, 0, .16), #0E1118); box-shadow: 0 0 0 1px var(--red); }
			.qz-modo b { font-size: 14px; }
			.qz-modo small { font-size: 11px; color: var(--txt2); }
			.qz-modo em { font-style: normal; font-size: 10.5px; color: #FFD24A; margin-top: 6px; font-weight: 700; }
			.qz-cfg { display: flex; gap: 10px; align-items: center; color: var(--txt2); font-weight: 700; margin-bottom: 22px; }
			.qz-go { height: 46px; padding: 0 34px; font-size: 16px; }
			.qz-novo { margin: 14px 0; font-size: 20px; font-weight: 900; color: #FFD24A; animation: f1-pulso 1.2s infinite; }
			.qz-rec { margin: 10px 0 !important; }
			.qz-fim-bts { display: flex; gap: 10px; margin-top: 20px; }
			
			.qz-top { display: flex; align-items: center; gap: 14px; color: var(--txt2); font-size: 13px; }
			.qz-top b { color: #fff; }
			.qz-tempo { flex: 1; height: 8px; background: #1A1F2B; border-radius: 4px; overflow: hidden; }
			.qz-tempo i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, var(--ok), #9BE15D); border-radius: 4px; transition: width .1s linear; }
			.qz-tempo i.alerta { background: linear-gradient(90deg, var(--red), #FF7A4"
			& "5); }
			.qz-seg { width: 34px; text-align: right; font-weight: 900; color: #fff; font-variant-numeric: tabular-nums; }
			.qz-corpo { display: flex; gap: 28px; align-items: center; margin: 26px 0 22px; height: 230px; }
			.qz-sil { width: 210px; height: 210px; border-radius: 50%; flex: none; position: relative; overflow: hidden; background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--c) 55%, #222), #0B0D12 75%); box-shadow: 0 0 0 4px var(--c), 0 0 40px color-mix(in srgb, var(--c) 50%, transparent); display: grid; place-items: center; }
			.qz-sil img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; filter: brightness(0) drop-shadow(0 0 0 #000); transition: filter .6s; }
			.qz-sil span { font-size: 96px; font-weight: 900; color: rgba(255, 255, 255, .18); }
			.qz-sil.revela img { filter: none; }
			.qz-sil.cl { background: none; box-shadow: none; overflow: visible; }
			.qz-trofeu { width: 210px; height: 210px; flex: none; display: grid; place-items: center; font-size: 110px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 210, 74, .18), transparent 65%); color: #FFD24A; }
			.qz-enun h3 { margin: 0 0 14px; font-size: 26px; font-weight: 900; line-height: 1.2; }
			.qz-pistas { display: flex; flex-direction: column; gap: 6px; }
			.qz-pista { font-size: 14px; color: var(--txt2); display: flex; gap: 8px; align-items: center; transition: opacity .4s, filter .4s; }
			.qz-pista b { color: #fff; }
			.qz-pista.oculta { opacity: .12; filter: blur(5px); }
			.qz-ops { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
			.qz-op { appearance: none; border: 1px solid var(--borda2); border-left: 5px solid var(--c); background: #0E1118; color: var(--txt); border-radius: 12px; height: 62px; display: flex; align-items: center; gap: 12px; padding: 0 16px; cursor: pointer; font-size: 16px; text-align: left; transition: transform .1s, background .15s, border-color .15s; }
			.qz-op:hover:not(:disabled) { background: #1A1F2B; transform: translateY(-1px); }
			.qz-op kbd { font-family: inherit; font-size: 11px; font-weight: 900; color: var(--txt3); border: 1px solid var(--borda2); border-radius: 5px; padding: 1px 6px; }
			.qz-op .f1-av.mini { width: 34px; height: 34px; }
			.qz-op .qz-eq { width: 28px; height: 28px; border-radius: 8px; background: var(--c); flex: none; }
			.qz-op.certo { background: rgba(43, 212, 125, .16); border-color: var(--ok); }
			.qz-op.errado { background: rgba(225, 6, 0, .16); border-color: var(--red); animation: qz-treme .35s; }
			.qz-op:disabled { cursor: default; }
			@keyframes qz-treme { 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
			.qz-fb { display: flex; align-items: center; justify-content: space-between; margin-top: 16px; min-height: 44px; }
			.qz-fb .ok, .qz-fb .nok { font-size: 20px; font-weight: 900; }
			.qz-fb .ok { color: var(--ok); }
			.qz-fb .nok { color: var(--red2); }
			.qz-fb span { color: var(--txt2); font-size: 14px; font-weight: 600; margin-left: 8px; }
			.qz-prox { height: 42px; padding: 0 22px; font-size: 14px; }
			"
		displayFolder: <HTML>\CSS
		lineageTag: 9a223357-863f-4534-b4aa-249754abfd47

	column Coluna
		dataType: string
		isHidden
		lineageTag: 70501cf3-6b3e-495c-9d33-99ce422a9426
		summarizeBy: none
		sourceColumn: Coluna

	partition _Medidas = m
		mode: import
		source =
				let
					Fonte = #table(type table [Coluna = text], {})
				in
					Fonte

